# ==========================================
# NADYSTORE BACKEND SECURITY ENVIRONMENT
# ==========================================

PORT=5001
NODE_ENV=production
FRONTEND_URL=https://nadystore.com

# JWT & Session Security
JWT_SECRET=your_super_strong_jwt_access_secret_64_chars_min
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_64_chars_min
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Supabase Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_private_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Distributed Rate Limiting (Optional Redis / Upstash for Multi-instance deployments)
REDIS_URL=redis://default:password@your-redis-host:6379

# Cloudflare Edge & Origin Shielding
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
SECURITY_SECRET=your_32_byte_custom_origin_verification_secret
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Payment Providers (CutLuy / Bakong KHQR / ABA)
CUTLUY_API_KEY=ck_live_...
CUTLUY_API_URL=https://cutluy.com/v1/payments
CUTLUY_WEBHOOK_SECRET=your_cutluy_webhook_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback
